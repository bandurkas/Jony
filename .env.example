# copy to .env (gitignored) and fill in
JONY_TRADING_MODE=paper
JONY_START_EQUITY_USD=800
# ex-Grogu Bybit account key (account freed by Grogu archival 2026-07-01)
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# advisor backend: api (кредиты, ANTHROPIC_API_KEY) | cli (MAX-подписка)
ADVISOR_BACKEND=api
ANTHROPIC_API_KEY=
# для cli: долгоживущий токен подписки из `claude setup-token` (sk-ant-oat01-...)
CLAUDE_CODE_OAUTH_TOKEN=

# trailing profit-lock (posture tight/lockdown, advisor positions)
# JONY_TRAIL_ARM=0.20
# JONY_TRAIL_GIVEBACK=0.10
# trail только на зрелом профите (close_policy: age>=70% hold, profit>=25%); 0 = прежнее поведение
# JONY_TRAIL_REQUIRE_ENDGAME=1
# мёртвый советник: heartbeat старше N ч -> эффективная posture tight + TG (0 = выкл)
# JONY_ADVISOR_STALE_H=3
